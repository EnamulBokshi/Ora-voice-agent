# ==============================================================================
# ORA Monorepo - Global Environment Configuration (.env)
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Frontend & Domain Configuration ---
PORT=3000
FRONTEND_URL=https://tryora.live
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=wss://tryora.live

# --- Database & Cache Credentials ---
MONGO_INITDB_ROOT_USERNAME=ora_prod_admin
MONGO_INITDB_ROOT_PASSWORD=ora_password_secure_replace_me
MONGO_INITDB_DATABASE=ora_production

# Custom Host Port Mapping (avoid VPS port conflicts)
ORA_MONGO_PORT=27018
ORA_REDIS_PORT=6380
ORA_SERVER_PORT=4000
ORA_CLIENT_PORT=4080

# Redis Password (optional, leave blank for local docker network)
REDIS_PASSWORD=

# --- Security & Cryptography Baseline ---
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_super_strong_random_jwt_secret_key_32_chars
JWT_EXPIRATION=15m
# Must be exactly 32 bytes for AES-256 field encryption
ENCRYPTION_SECRET=ora-aes-256-secret-key-32bytes!

# --- Google Gemini AI & Multimodal Live API ---
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_LIVE_MODEL=models/gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- RAG Engine Confidence Thresholds ---
RAG_PRODUCT_CONFIDENCE_THRESHOLD=0.65
RAG_KNOWLEDGE_CONFIDENCE_THRESHOLD=0.60
LOW_STOCK_THRESHOLD=5

# --- E-Commerce Ingestion Webhooks ---
SHOPIFY_API_SECRET=your_shopify_app_secret

# --- Stripe Billing Engine ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# --- Email Notifications & OTP (Resend API) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ORA Onboarding <onboarding@noreply.magicfunnel.io>
