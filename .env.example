# ==============================================================================
# ORA Monorepo - Global Environment Configuration (.env)
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Frontend & Domain Configuration ---
PORT=3000
FRONTEND_URL=https://tryora.live
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=wss://tryora.live

# --- Database & Cache Credentials ---
MONGO_INITDB_ROOT_USERNAME=ora_prod_admin
MONGO_INITDB_ROOT_PASSWORD=ora_password_secure_replace_me
MONGO_INITDB_DATABASE=ora_production

# Custom Host Port Mapping (avoid VPS port conflicts)
ORA_MONGO_PORT=27018
ORA_REDIS_PORT=6380
ORA_SERVER_PORT=4000
ORA_CLIENT_PORT=4080
# Shopify embedded app container. nginx/Caddy serves it at /shopify.

# Redis Password (optional, leave blank for local docker network)
REDIS_PASSWORD=

# --- Security & Cryptography Baseline ---
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_super_strong_random_jwt_secret_key_32_chars
JWT_EXPIRATION=15m
# Must be exactly 32 bytes for AES-256 field encryption
ENCRYPTION_SECRET=ora-aes-256-secret-key-32bytes!

# --- Platform SuperAdmin Provisioning ---
ADMIN_EMAIL=ora.admin@tryora.live
ADMIN_PASSWORD=replace_with_a_super_strong_admin_password
ADMIN_NAME=Platform SuperAdmin

# --- Google Gemini AI & Multimodal Live API ---
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- RAG Engine Confidence Thresholds ---
RAG_PRODUCT_CONFIDENCE_THRESHOLD=0.65
RAG_KNOWLEDGE_CONFIDENCE_THRESHOLD=0.60
LOW_STOCK_THRESHOLD=5

# --- Shopify Embedded App & Ingestion Webhooks ---
# From the Shopify Partner Dashboard: Client ID and Client Secret.
# SHOPIFY_API_SECRET signs both webhooks and App Bridge session tokens, and
# SHOPIFY_API_KEY is the expected `aud` of every session token — with either
# unset, the embedded app cannot authenticate at all.
SHOPIFY_API_KEY=your_shopify_app_client_id
SHOPIFY_API_SECRET=your_shopify_app_secret
SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_orders

# Two values, one origin, not interchangeable:
#   ORA_API_URL     - the API's public origin. Builds the webhook endpoint, the
#                     OAuth callback, and the billing return URL.
#   SHOPIFY_APP_URL - where the embedded frontend is served, which Shopify Admin
#                     loads in an iframe.
# Point ORA_API_URL at the frontend path by mistake and Shopify accepts the
# webhook registration, then 404s every delivery — catalog sync stops silently.
ORA_API_URL=https://tryora.live
SHOPIFY_APP_URL=https://tryora.live/shopify

# Relative on purpose: the embedded app is same-origin with the API, so its
# calls need no CORS. Only change this if the app moves to its own host.
NEXT_PUBLIC_ORA_API_URL=/api/v1

# --- Stripe Billing Engine ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# --- Email Notifications & OTP (Resend API) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ORA Onboarding <onboarding@noreply.magicfunnel.io>
