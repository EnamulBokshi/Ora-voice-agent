{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "mail/templates/**/*",
        "outDir": "dist/mail/templates",
        "watchAssets": true
      }
    ]
  },
  "watchOptions": {
    "poll": 1000,
    "aggregateTimeout": 500
  }
}