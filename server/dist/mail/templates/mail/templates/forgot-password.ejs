<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <h1 style="margin: 0 0 12px 0; color: #15151F; font-size: 24px; font-weight: 800;">Reset your ORA password</h1>
      <p style="margin: 0 0 20px 0; color: #4A4A6A; font-size: 15px; line-height: 24px;">
        Hi <strong><%= recipientName %></strong>,<br>
        We received a request to reset the password for your ORA Sales Command Center account. Click the button below to choose a new password.
      </p>
    </td>
  </tr>

  <!-- CTA Button -->
  <tr>
    <td align="center" style="padding: 12px 0 28px 0;">
      <table border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td align="center" style="border-radius: 10px; background: linear-gradient(135deg, #6C5CE7 0%, #5645C7 100%); box-shadow: 0 6px 18px rgba(108, 92, 231, 0.35);">
            <a href="<%= resetUrl %>" target="_blank" style="font-size: 15px; font-family: sans-serif; color: #FFFFFF; text-decoration: none; border-radius: 10px; padding: 14px 34px; display: inline-block; font-weight: 700;">
              Reset Password Now &rarr;
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Direct Link Fallback -->
  <tr>
    <td style="background-color: #F7F7FB; border: 1px solid #E4E4EE; border-radius: 10px; padding: 16px; margin-bottom: 24px;">
      <span style="color: #6B6B8A; font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">
        Button not working? Copy and paste this link into your browser:
      </span>
      <a href="<%= resetUrl %>" style="color: #6C5CE7; font-size: 12px; word-break: break-all; font-family: monospace;">
        <%= resetUrl %>
      </a>
    </td>
  </tr>

  <!-- Expiration Note -->
  <tr>
    <td style="padding-top: 16px;">
      <p style="margin: 0 0 12px 0; color: #6B6B8A; font-size: 13px;">
        This password reset link is single-use only and expires in <strong><%= expireMinutes || 30 %> minutes</strong>.
      </p>
      <p style="margin: 0; color: #8B8BB0; font-size: 13px; line-height: 18px;">
        If you didn't request a password reset, you can safely ignore this email. Your password will remain unchanged.
      </p>
    </td>
  </tr>
</table>
