<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <h1 style="margin: 0 0 12px 0; color: #FAFAFA; font-size: 22px; font-weight: 800; letter-spacing: -0.4px;">
        <%= heading %>
      </h1>
      <p style="margin: 0 0 20px 0; color: #D1D5DB; font-size: 14px; line-height: 22px;">
        Hi <%= recipientName %>,
      </p>
    </td>
  </tr>

  <tr>
    <td style="background-color: #181818; border-radius: 12px; padding: 22px; border: 1px solid #262626;">
      <div style="color: #D1D5DB; font-size: 14px; line-height: 22px; white-space: pre-wrap;"><%= message %></div>
    </td>
  </tr>

  <% if (ctaUrl) { %>
  <tr>
    <td align="center" style="padding-top: 24px;">
      <a href="<%= ctaUrl %>" style="display: inline-block; background-color: #C8F031; color: #111111; font-size: 14px; font-weight: 700; text-decoration: none; padding: 12px 28px; border-radius: 8px;">
        <%= ctaLabel %>
      </a>
    </td>
  </tr>
  <% } %>

  <tr>
    <td style="padding-top: 24px;">
      <p style="margin: 0; color: #9CA3AF; font-size: 12px; line-height: 20px;">
        — <%= senderName %>, ORA
      </p>
    </td>
  </tr>
</table>
