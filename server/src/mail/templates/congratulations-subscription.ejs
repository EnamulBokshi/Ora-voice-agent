<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <!-- Badge -->
      <div style="display: inline-block; background-color: rgba(200, 240, 49, 0.12); border: 1px solid rgba(200, 240, 49, 0.28); border-radius: 20px; padding: 4px 12px; margin-bottom: 14px;">
        <span style="color: #C8F031; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;">
          Subscription Confirmed
        </span>
      </div>
      <h1 style="margin: 0 0 10px 0; color: #FAFAFA; font-size: 24px; font-weight: 800; letter-spacing: -0.5px;">
        🎉 Subscription Confirmed!
      </h1>
      <p style="margin: 0 0 22px 0; color: #D1D5DB; font-size: 14px; line-height: 22px;">
        Hello <strong><%= recipientName %></strong>, your subscription to the <strong><%= planName %></strong> for <strong><%= storeName %></strong> is now active. You have been upgraded to <strong>Store Owner</strong> with full access to live voice sessions, AI agent training, and conversion intelligence.
      </p>
    </td>
  </tr>

  <!-- Subscription Details Card -->
  <tr>
    <td style="background-color: #181818; border-radius: 12px; padding: 22px; margin-bottom: 22px; border: 1px solid #262626;">
      <span style="color: #C8F031; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; display: block; margin-bottom: 14px;">
        Plan & Access Summary
      </span>
      
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td style="padding-bottom: 10px; color: #9CA3AF; font-size: 13px; width: 140px;">
            Plan Tier:
          </td>
          <td style="padding-bottom: 10px; color: #FAFAFA; font-size: 13px; font-weight: 700;">
            <%= planName %>
          </td>
        </tr>
        <tr>
          <td style="padding-bottom: 10px; color: #9CA3AF; font-size: 13px;">
            Store Workspace:
          </td>
          <td style="padding-bottom: 10px; color: #FAFAFA; font-size: 13px; font-weight: 700;">
            <%= storeName %>
          </td>
        </tr>
        <tr>
          <td style="padding-bottom: 10px; color: #9CA3AF; font-size: 13px;">
            Role Granted:
          </td>
          <td style="padding-bottom: 10px; color: #C8F031; font-size: 13px; font-weight: 700;">
            Owner (Full Access)
          </td>
        </tr>
        <tr>
          <td style="color: #9CA3AF; font-size: 13px;">
            Status:
          </td>
          <td style="color: #C8F031; font-size: 13px; font-weight: 700;">
            ● Active Subscription
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Next Steps -->
  <tr>
    <td style="padding: 16px 0 8px 0;">
      <p style="margin: 0 0 6px 0; color: #FAFAFA; font-size: 13px; font-weight: 700;">
        What's next?
      </p>
      <p style="margin: 0 0 16px 0; color: #9CA3AF; font-size: 12px; line-height: 18px;">
        We've sent your <strong>ORA Voice AI Credentials & User Manual</strong> containing your store's live publishable key and the 1-minute website embed script. You can now log into your merchant dashboard to train your sales agent, upload product catalogs, and review live conversations.
      </p>
    </td>
  </tr>

  <!-- CTA Button -->
  <tr>
    <td align="center" style="padding: 6px 0 20px 0;">
      <table border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td align="center" style="border-radius: 8px; background-color: #C8F031; box-shadow: 0 4px 14px rgba(200, 240, 49, 0.3);">
            <a href="<%= dashboardUrl %>" target="_blank" style="font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #111111; text-decoration: none; border-radius: 8px; padding: 13px 32px; display: inline-block; font-weight: 800; letter-spacing: 0.2px;">
              Go to Merchant Dashboard &rarr;
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
