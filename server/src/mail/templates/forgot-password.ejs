<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <!-- Badge -->
      <div style="display: inline-block; background-color: rgba(200, 240, 49, 0.12); border: 1px solid rgba(200, 240, 49, 0.28); border-radius: 20px; padding: 4px 12px; margin-bottom: 14px;">
        <span style="color: #C8F031; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;">
          Password Recovery
        </span>
      </div>
      <h1 style="margin: 0 0 12px 0; color: #FAFAFA; font-size: 23px; font-weight: 800; letter-spacing: -0.5px;">Reset your ORA password</h1>
      <p style="margin: 0 0 22px 0; color: #D1D5DB; font-size: 14px; line-height: 22px;">
        Hi <strong><%= recipientName %></strong>,<br>
        We received a request to reset the password for your ORA Sales Command Center account. Click the button below to establish a new password.
      </p>
    </td>
  </tr>

  <!-- CTA Button -->
  <tr>
    <td align="center" style="padding: 6px 0 26px 0;">
      <table border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td align="center" style="border-radius: 8px; background-color: #C8F031; box-shadow: 0 4px 14px rgba(200, 240, 49, 0.3);">
            <a href="<%= resetUrl %>" target="_blank" style="font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #111111; text-decoration: none; border-radius: 8px; padding: 13px 32px; display: inline-block; font-weight: 800; letter-spacing: 0.2px;">
              Reset Password Now &rarr;
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Direct Link Fallback -->
  <tr>
    <td style="background-color: #181818; border: 1px solid #262626; border-radius: 10px; padding: 16px; margin-bottom: 22px;">
      <span style="color: #9CA3AF; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; display: block; margin-bottom: 6px;">
        Button not working? Copy and paste this link:
      </span>
      <a href="<%= resetUrl %>" style="color: #C8F031; font-size: 12px; word-break: break-all; font-family: 'JetBrains Mono', 'Courier New', monospace; text-decoration: underline;">
        <%= resetUrl %>
      </a>
    </td>
  </tr>

  <!-- Expiration Note -->
  <tr>
    <td style="padding-top: 20px; border-top: 1px solid #1F1F1F;">
      <p style="margin: 0 0 8px 0; color: #888888; font-size: 12px;">
        This password reset link is single-use only and expires in <strong style="color: #FAFAFA;"><%= expireMinutes || 30 %> minutes</strong>.
      </p>
      <p style="margin: 0; color: #6B7280; font-size: 12px; line-height: 18px;">
        If you did not request a password reset, you can safely ignore this email. Your password and account will remain unchanged.
      </p>
    </td>
  </tr>
</table>
