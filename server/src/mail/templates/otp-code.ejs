<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <div
        style="display: inline-block; background-color: rgba(108, 92, 231, 0.1); border: 1px solid rgba(108, 92, 231, 0.2); border-radius: 20px; padding: 4px 12px; margin-bottom: 12px;">
        <span
          style="color: #6C5CE7; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;">
          Security Check
        </span>
      </div>
      <h1 style="margin: 0 0 10px 0; color: #15151F; font-size: 24px; font-weight: 800;">One-Time Verification Code</h1>
      <p style="margin: 0 0 24px 0; color: #4A4A6A; font-size: 15px; line-height: 22px;">
        Hi <strong>
          <%= recipientName %>
        </strong>,<br>
        Use the following 6-digit passcode to complete your <strong>
          <%= actionName || 'account verification' %>
        </strong> request.
      </p>
    </td>
  </tr>

  <!-- Prominent OTP Code Block -->
  <tr>
    <td align="center" style="padding-bottom: 24px;">
      <div
        style="background: linear-gradient(135deg, #12121A 0%, #1B1C27 100%); border-radius: 14px; padding: 24px 30px; text-align: center; box-shadow: 0 8px 20px rgba(0,0,0,0.15); border: 1px solid #2A2C3A; width: 85%;">
        <span
          style="color: #8B8BB0; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 10px;">
          Your 6-Digit Passcode
        </span>
        <div class="otp-code"
          style="font-family: 'Courier New', Courier, monospace; font-size: 36px; font-weight: 800; color: #2DD4C8; letter-spacing: 10px; text-shadow: 0 0 12px rgba(45, 212, 200, 0.4);">
          <%= code %>
        </div>
        <span style="color: #EDEEF4; font-size: 12px; display: block; margin-top: 12px; opacity: 0.8;">
          Valid for <strong>
            <%= expireMinutes || 10 %> minutes
          </strong> &bull; Do not share this code with anyone
        </span>
      </div>
    </td>
  </tr>

  <% if (ipAddress || device) { %>
    <tr>
      <td
        style="background-color: #F7F7FB; border: 1px solid #E4E4EE; border-radius: 10px; padding: 14px 18px; margin-bottom: 24px;">
        <table border="0" cellpadding="0" cellspacing="0" width="100%">
          <tr>
            <td style="color: #6B6B8A; font-size: 12px; font-weight: 600; line-height: 18px;">
              <% if (device) { %><strong>Device:</strong>
                <%= device %><br>
                  <% } %>
                    <% if (ipAddress) { %><strong>IP Address:</strong>
                      <%= ipAddress %><br>
                        <% } %>
                          <strong>Time:</strong>
                          <%= new Date().toUTCString() %>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    <% } %>

      <tr>
        <td style="padding-top: 16px; border-top: 1px solid #F0F0F8;">
          <p style="margin: 0; color: #DC2626; font-size: 13px; line-height: 18px; font-weight: 500;">
            ⚠️ If you did not request this OTP code, someone may be attempting to access your account. Please change
            your password immediately.
          </p>
        </td>
      </tr>
</table>