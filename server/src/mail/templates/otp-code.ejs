<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <!-- Badge -->
      <div style="display: inline-block; background-color: rgba(200, 240, 49, 0.12); border: 1px solid rgba(200, 240, 49, 0.28); border-radius: 20px; padding: 4px 12px; margin-bottom: 14px;">
        <span style="color: #C8F031; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;">
          Security Check
        </span>
      </div>
      <h1 style="margin: 0 0 10px 0; color: #FAFAFA; font-size: 23px; font-weight: 800; letter-spacing: -0.5px;">One-Time Verification Code</h1>
      <p style="margin: 0 0 24px 0; color: #D1D5DB; font-size: 14px; line-height: 22px;">
        Hi <strong><%= recipientName %></strong>,<br>
        Use this single-use 6-digit passcode to complete your <strong><%= actionName || 'account verification' %></strong> request.
      </p>
    </td>
  </tr>

  <!-- Prominent OTP Code Block -->
  <tr>
    <td align="center" style="padding-bottom: 24px;">
      <div style="background-color: #080808; border-radius: 12px; padding: 22px 28px; text-align: center; border: 1px solid #2A2A2A; width: 88%; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);">
        <span style="color: #9CA3AF; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 10px;">
          Your 6-Digit Passcode
        </span>
        <div class="otp-code" style="font-family: 'JetBrains Mono', 'Courier New', Courier, monospace; font-size: 36px; font-weight: 800; color: #C8F031; letter-spacing: 10px; text-shadow: 0 0 14px rgba(200, 240, 49, 0.35); padding: 4px 0;">
          <%= code %>
        </div>
        <span style="color: #888888; font-size: 12px; display: block; margin-top: 10px;">
          Valid for <strong style="color: #FAFAFA;"><%= expireMinutes || 10 %> minutes</strong> &bull; Do not share this code with anyone
        </span>
      </div>
    </td>
  </tr>

  <% if (ipAddress || device) { %>
  <tr>
    <td style="background-color: #181818; border: 1px solid #262626; border-radius: 10px; padding: 14px 18px; margin-bottom: 24px;">
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td style="color: #9CA3AF; font-size: 12px; line-height: 20px;">
            <% if (device) { %><strong style="color: #FAFAFA;">Device:</strong> <%= device %><br><% } %>
            <% if (ipAddress) { %><strong style="color: #FAFAFA;">IP Address:</strong> <%= ipAddress %><br><% } %>
            <strong style="color: #FAFAFA;">Timestamp:</strong> <%= new Date().toUTCString() %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <% } %>

  <tr>
    <td style="padding-top: 20px; border-top: 1px solid #1F1F1F;">
      <p style="margin: 0; color: #F87171; font-size: 12px; line-height: 18px; font-weight: 500;">
        ⚠️ If you did not request this verification code, someone may be attempting to access your account. Please change your password immediately.
      </p>
    </td>
  </tr>
</table>