<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <div style="display: inline-block; background-color: rgba(45, 212, 200, 0.12); border: 1px solid rgba(45, 212, 200, 0.3); border-radius: 20px; padding: 4px 12px; margin-bottom: 12px;">
        <span style="color: #129E93; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;">
          Team Invitation
        </span>
      </div>
      <h1 style="margin: 0 0 12px 0; color: #15151F; font-size: 24px; font-weight: 800;">You've been invited to join <%= storeName %></h1>
      <p style="margin: 0 0 20px 0; color: #4A4A6A; font-size: 15px; line-height: 24px;">
        Hi <strong><%= recipientName %></strong>,<br>
        <strong><%= inviterName %></strong> has invited you to join their team on <strong>ORA Sales Command Center</strong>.
      </p>
    </td>
  </tr>

  <!-- Role & Store Summary Card -->
  <tr>
    <td style="background-color: #F7F7FB; border: 1px solid #E4E4EE; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td style="padding-bottom: 10px; color: #6B6B8A; font-size: 13px;">
            <strong>Store Name:</strong> <span style="color: #15151F; font-weight: 700;"><%= storeName %></span>
          </td>
        </tr>
        <tr>
          <td style="padding-bottom: 10px; color: #6B6B8A; font-size: 13px;">
            <strong>Assigned Role:</strong> 
            <span style="background-color: #6C5CE7; color: #FFFFFF; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; display: inline-block; margin-left: 4px;">
              <%= role %>
            </span>
          </td>
        </tr>
        <tr>
          <td style="color: #6B6B8A; font-size: 13px;">
            <strong>Invited By:</strong> <%= inviterName %>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- CTA Button -->
  <tr>
    <td align="center" style="padding: 10px 0 24px 0;">
      <table border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td align="center" style="border-radius: 10px; background: linear-gradient(135deg, #6C5CE7 0%, #5645C7 100%); box-shadow: 0 6px 18px rgba(108, 92, 231, 0.35);">
            <a href="<%= inviteUrl %>" target="_blank" style="font-size: 15px; font-family: sans-serif; color: #FFFFFF; text-decoration: none; border-radius: 10px; padding: 14px 34px; display: inline-block; font-weight: 700;">
              Accept Invitation & Join Store &rarr;
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <tr>
    <td style="padding-top: 16px; border-top: 1px solid #F0F0F8;">
      <p style="margin: 0; color: #8B8BB0; font-size: 13px;">
        If you were not expecting this invitation, you can ignore this email or contact the store owner.
      </p>
    </td>
  </tr>
</table>
