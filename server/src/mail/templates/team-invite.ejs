<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <!-- Badge -->
      <div style="display: inline-block; background-color: rgba(200, 240, 49, 0.12); border: 1px solid rgba(200, 240, 49, 0.28); border-radius: 20px; padding: 4px 12px; margin-bottom: 14px;">
        <span style="color: #C8F031; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;">
          Team Invitation
        </span>
      </div>
      <h1 style="margin: 0 0 12px 0; color: #FAFAFA; font-size: 23px; font-weight: 800; letter-spacing: -0.5px;">You've been invited to join <%= storeName %></h1>
      <p style="margin: 0 0 22px 0; color: #D1D5DB; font-size: 14px; line-height: 22px;">
        Hi <strong><%= recipientName %></strong>,<br>
        <strong><%= inviterName %></strong> has invited you to collaborate on <strong>ORA Sales Command Center</strong>.
      </p>
    </td>
  </tr>

  <!-- Role & Store Summary Card -->
  <tr>
    <td style="background-color: #181818; border: 1px solid #262626; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td style="padding-bottom: 10px; color: #9CA3AF; font-size: 13px;">
            Store Name:
          </td>
          <td style="padding-bottom: 10px; color: #FAFAFA; font-weight: 700; font-size: 13px;">
            <%= storeName %>
          </td>
        </tr>
        <tr>
          <td style="padding-bottom: 10px; color: #9CA3AF; font-size: 13px;">
            Assigned Role:
          </td>
          <td style="padding-bottom: 10px;">
            <span style="background-color: #C8F031; color: #111111; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; display: inline-block;">
              <%= role %>
            </span>
          </td>
        </tr>
        <tr>
          <td style="color: #9CA3AF; font-size: 13px;">
            Invited By:
          </td>
          <td style="color: #FAFAFA; font-size: 13px; font-weight: 600;">
            <%= inviterName %>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- CTA Button -->
  <tr>
    <td align="center" style="padding: 6px 0 24px 0;">
      <table border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td align="center" style="border-radius: 8px; background-color: #C8F031; box-shadow: 0 4px 14px rgba(200, 240, 49, 0.3);">
            <a href="<%= inviteUrl %>" target="_blank" style="font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #111111; text-decoration: none; border-radius: 8px; padding: 13px 32px; display: inline-block; font-weight: 800; letter-spacing: 0.2px;">
              Accept Invitation & Join Store &rarr;
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <tr>
    <td style="padding-top: 18px; border-top: 1px solid #1F1F1F;">
      <p style="margin: 0; color: #6B7280; font-size: 12px; line-height: 18px;">
        If you were not expecting this invitation, you can safely ignore this email or contact the store owner.
      </p>
    </td>
  </tr>
</table>
