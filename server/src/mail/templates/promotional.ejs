<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <h1 style="margin: 0 0 12px 0; color: #FAFAFA; font-size: 22px; font-weight: 800; letter-spacing: -0.4px;">
        <%= heading %>
      </h1>
      <p style="margin: 0 0 20px 0; color: #D1D5DB; font-size: 14px; line-height: 22px;">
        Hi <%= recipientName %>,
      </p>
    </td>
  </tr>

  <tr>
    <td style="background-color: #181818; border-radius: 12px; padding: 22px; border: 1px solid #262626;">
      <div style="color: #D1D5DB; font-size: 14px; line-height: 22px; white-space: pre-wrap;"><%= message %></div>
    </td>
  </tr>

  <% if (couponCode) { %>
  <tr>
    <td style="padding-top: 20px;">
      <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: rgba(200, 240, 49, 0.08); border: 1px dashed rgba(200, 240, 49, 0.45); border-radius: 12px;">
        <tr>
          <td align="center" style="padding: 20px;">
            <span style="display: block; color: #9CA3AF; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 8px;">
              Your coupon code
            </span>
            <span style="display: block; color: #C8F031; font-size: 26px; font-weight: 800; letter-spacing: 2px; font-family: 'Courier New', monospace;">
              <%= couponCode %>
            </span>
            <% if (couponDetail) { %>
            <span style="display: block; color: #9CA3AF; font-size: 12px; margin-top: 8px;">
              <%= couponDetail %>
            </span>
            <% } %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <% } %>

  <% if (ctaUrl) { %>
  <tr>
    <td align="center" style="padding-top: 24px;">
      <a href="<%= ctaUrl %>" style="display: inline-block; background-color: #C8F031; color: #111111; font-size: 14px; font-weight: 700; text-decoration: none; padding: 12px 28px; border-radius: 8px;">
        <%= ctaLabel %>
      </a>
    </td>
  </tr>
  <% } %>

  <tr>
    <td style="padding-top: 26px; border-top: 1px solid #262626; margin-top: 20px;">
      <p style="margin: 16px 0 0 0; color: #6B7280; font-size: 11px; line-height: 18px;">
        You are receiving this because you have an ORA merchant account.
        <a href="<%= unsubscribeUrl %>" style="color: #9CA3AF; text-decoration: underline;">Unsubscribe from promotional email</a>.
        Account and billing notices will still reach you.
      </p>
    </td>
  </tr>
</table>
