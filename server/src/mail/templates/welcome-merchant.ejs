<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <h1 style="margin: 0 0 10px 0; color: #15151F; font-size: 26px; font-weight: 800; letter-spacing: -0.5px;">
        🚀 Welcome to ORA, <%= recipientName %>!
      </h1>
      <p style="margin: 0 0 24px 0; color: #4A4A6A; font-size: 15px; line-height: 24px;">
        Your merchant workspace for <strong><%= storeName %></strong> is now live! ORA empowers your brand with 24/7 autonomous AI voice agents, live analytics, and instant conversion tracking.
      </p>
    </td>
  </tr>

  <!-- Onboarding Checklist Card -->
  <tr>
    <td style="background: linear-gradient(135deg, #12121A 0%, #1B1C27 100%); border-radius: 14px; padding: 24px; color: #EDEEF4; margin-bottom: 24px; border: 1px solid #2A2C3A;">
      <span style="color: #2DD4C8; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; display: block; margin-bottom: 14px;">
        Quick Start Guide — 3 Simple Steps
      </span>
      
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td valign="top" style="padding-bottom: 14px; width: 28px;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #6C5CE7; color: #FFFFFF; font-size: 12px; font-weight: 800; text-align: center; line-height: 22px;">1</div>
          </td>
          <td style="padding-bottom: 14px; color: #EDEEF4; font-size: 14px; line-height: 20px;">
            <strong>Sync Product Catalog:</strong> Import items from Shopify or WooCommerce.
          </td>
        </tr>
        <tr>
          <td valign="top" style="padding-bottom: 14px; width: 28px;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #6C5CE7; color: #FFFFFF; font-size: 12px; font-weight: 800; text-align: center; line-height: 22px;">2</div>
          </td>
          <td style="padding-bottom: 14px; color: #EDEEF4; font-size: 14px; line-height: 20px;">
            <strong>Configure AI Voice Agent:</strong> Set tone of voice, upsell behavior & guardrails.
          </td>
        </tr>
        <tr>
          <td valign="top" style="width: 28px;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #2DD4C8; color: #12121A; font-size: 12px; font-weight: 800; text-align: center; line-height: 22px;">3</div>
          </td>
          <td style="color: #EDEEF4; font-size: 14px; line-height: 20px;">
            <strong>Go Live:</strong> Embed the voice widget on your website and watch conversions soar!
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- CTA Button -->
  <tr>
    <td align="center" style="padding: 10px 0 24px 0;">
      <table border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td align="center" style="border-radius: 10px; background: linear-gradient(135deg, #6C5CE7 0%, #5645C7 100%); box-shadow: 0 6px 18px rgba(108, 92, 231, 0.35);">
            <a href="<%= dashboardUrl %>" target="_blank" style="font-size: 15px; font-family: sans-serif; color: #FFFFFF; text-decoration: none; border-radius: 10px; padding: 14px 34px; display: inline-block; font-weight: 700;">
              Launch ORA Command Center &rarr;
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
