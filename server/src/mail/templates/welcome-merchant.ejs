<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <!-- Badge -->
      <div style="display: inline-block; background-color: rgba(200, 240, 49, 0.12); border: 1px solid rgba(200, 240, 49, 0.28); border-radius: 20px; padding: 4px 12px; margin-bottom: 14px;">
        <span style="color: #C8F031; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;">
          Autonomous AI Commerce
        </span>
      </div>
      <h1 style="margin: 0 0 12px 0; color: #FAFAFA; font-size: 24px; font-weight: 800; letter-spacing: -0.5px;">
        🚀 Welcome to ORA, <%= recipientName %>!
      </h1>
      <p style="margin: 0 0 24px 0; color: #D1D5DB; font-size: 14px; line-height: 22px;">
        Your merchant workspace for <strong><%= storeName %></strong> is now active. ORA equips your store with 24/7 autonomous multimodal AI sales agents, live catalog intelligence, and instant voice-guided checkout.
      </p>
    </td>
  </tr>

  <!-- Onboarding Checklist Card -->
  <tr>
    <td style="background-color: #181818; border-radius: 12px; padding: 22px; margin-bottom: 24px; border: 1px solid #262626;">
      <span style="color: #C8F031; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; display: block; margin-bottom: 16px;">
        Quick Start Playbook — 3 Simple Steps
      </span>
      
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td valign="top" style="padding-bottom: 14px; width: 32px;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #C8F031; color: #111111; font-size: 12px; font-weight: 800; text-align: center; line-height: 22px;">1</div>
          </td>
          <td style="padding-bottom: 14px; color: #D1D5DB; font-size: 13px; line-height: 20px;">
            <strong style="color: #FAFAFA;">Sync Product Catalog:</strong> Import items from Shopify, WooCommerce, or direct CSV upload.
          </td>
        </tr>
        <tr>
          <td valign="top" style="padding-bottom: 14px; width: 32px;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #C8F031; color: #111111; font-size: 12px; font-weight: 800; text-align: center; line-height: 22px;">2</div>
          </td>
          <td style="padding-bottom: 14px; color: #D1D5DB; font-size: 13px; line-height: 20px;">
            <strong style="color: #FAFAFA;">Configure AI Agent Persona:</strong> Fine-tune tone of voice, upsell incentives, and store FAQs.
          </td>
        </tr>
        <tr>
          <td valign="top" style="width: 32px;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #C8F031; color: #111111; font-size: 12px; font-weight: 800; text-align: center; line-height: 22px;">3</div>
          </td>
          <td style="color: #D1D5DB; font-size: 13px; line-height: 20px;">
            <strong style="color: #FAFAFA;">Go Live:</strong> Embed the voice assistant widget on your website and watch conversions soar!
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- CTA Button -->
  <tr>
    <td align="center" style="padding: 6px 0 22px 0;">
      <table border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td align="center" style="border-radius: 8px; background-color: #C8F031; box-shadow: 0 4px 14px rgba(200, 240, 49, 0.3);">
            <a href="<%= dashboardUrl %>" target="_blank" style="font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #111111; text-decoration: none; border-radius: 8px; padding: 13px 32px; display: inline-block; font-weight: 800; letter-spacing: 0.2px;">
              Launch ORA Command Center &rarr;
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
