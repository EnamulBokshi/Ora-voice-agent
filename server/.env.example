# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://ora_admin:ora_password_dev@localhost:27017/ora_db?authSource=admin

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Encryption Baseline (AES-256 + JWT)
JWT_SECRET=super_secret_dev_key_change_in_production
JWT_EXPIRATION=15m
ENCRYPTION_SECRET=ora-aes-256-secret-key-32bytes!

# AI Voice & Vector Embeddings (Gemini Multimodal Live API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_LIVE_MODEL=models/gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# RAG Engine Confidence Thresholds (no code deploy needed to tune)
RAG_PRODUCT_CONFIDENCE_THRESHOLD=0.65
RAG_KNOWLEDGE_CONFIDENCE_THRESHOLD=0.60

# Low-Stock Urgency Threshold — products at or below this qty are flagged isLowStock: true
LOW_STOCK_THRESHOLD=5

# Ingestion Engine Secrets (Tier 1 Webhooks)
SHOPIFY_API_SECRET=your_shopify_app_api_secret_here

# Payment Billing Engine Secrets (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Email Verification & OTP Engine (Resend API)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=ORA Onboarding <onboarding@noreply.magicfunnel.io>

# Alternative SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="ORA Verification" <no-reply@ora.ai>
