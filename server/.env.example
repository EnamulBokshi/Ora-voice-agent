# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://ora_admin:ora_password_dev@localhost:27017/ora_db?authSource=admin

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Encryption Baseline (AES-256 + JWT)
JWT_SECRET=super_secret_dev_key_change_in_production
JWT_EXPIRATION=15m
# Encrypts connector credentials at rest (Shopify access tokens, WooCommerce
# secrets). Any length works — the value is scrypt-derived into a 32-byte key.
#
# Leaving it unset is safe: EncryptionUtil throws outright when NODE_ENV is
# production, and warns once in development. The real hazard is SETTING it to
# the development constant from common/utils/encryption.util.ts, which defeats
# that guard and lets anyone with the source decrypt every stored merchant
# token. Generate a unique value: `openssl rand -base64 32`.
#
# Rotating it later makes already-stored credentials undecryptable, so set the
# production value before the first live install.
ENCRYPTION_SECRET=generate_a_unique_secret_do_not_copy_this_line

# AI Voice & Vector Embeddings (Gemini Multimodal Live API)
# Single key or multiple failover keys (newline-separated in quotes or numbered vars)
# GEMINI_API_KEYS="key_one
# key_two"
# GEMINI_API_KEY_1=key_one
# GEMINI_API_KEY_2=key_two
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# RAG Engine Confidence Thresholds (no code deploy needed to tune)
RAG_PRODUCT_CONFIDENCE_THRESHOLD=0.65
RAG_KNOWLEDGE_CONFIDENCE_THRESHOLD=0.60

# Low-Stock Urgency Threshold — products at or below this qty are flagged isLowStock: true
LOW_STOCK_THRESHOLD=5

# Ingestion Engine Secrets (Tier 1 Webhooks)
# Required. Without these, every inbound platform webhook is rejected.
# Shopify signs with the app's own secret, so it is one value for every tenant.
# WOOCOMMERCE_WEBHOOK_SECRET is the fallback for stores with no per-store
# secret set on Business.woocommerceWebhookSecret.
SHOPIFY_API_SECRET=your_shopify_app_api_secret_here
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret_here

# Shopify Embedded App (Partner Dashboard -> your app)
# SHOPIFY_API_KEY is the app's Client ID. It is also the expected `aud` claim of
# every App Bridge session token, so an unset value fails session verification.
# SHOPIFY_API_SECRET above signs both webhooks and session tokens. Without it,
# every session token and every webhook is rejected.
# SHOPIFY_SCOPES must match the `scopes` list in packages/shopify-app/shopify.app.toml.
#
# Two origins, and they are NOT interchangeable:
#   ORA_API_URL     - this API's own origin. Used to build every address Shopify
#                     calls back on: the webhook endpoint, the OAuth callback,
#                     and the billing return URL.
#   SHOPIFY_APP_URL - Shopify's "App URL": the origin serving the embedded
#                     frontend, which Shopify Admin loads in an iframe. That is
#                     the ORA client's /shopify route tree
#                     (client/app/shopify/), not a separate service.
#
# In a single-host deployment they are the same value. In a split deployment
# they are not, and setting only SHOPIFY_APP_URL registers webhooks against the
# frontend host — Shopify accepts the registration and then every delivery
# 404s, so catalog sync fails silently.
SHOPIFY_API_KEY=your_shopify_partner_app_client_id
SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_orders
ORA_API_URL=https://api.ora.example.com
SHOPIFY_APP_URL=https://shopify.ora.example.com

# Payment Billing Engine Secrets (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Payment Billing Engine Secrets (bKash) — read by billing/providers/bkash.provider.ts
BKASH_APP_KEY=your_bkash_app_key_here
BKASH_APP_SECRET=your_bkash_app_secret_here
BKASH_USERNAME=your_bkash_username_here
BKASH_PASSWORD=your_bkash_password_here
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Email Verification & OTP Engine (Resend API)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=ORA Onboarding <onboarding@noreply.magicfunnel.io>

# Alternative SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="ORA Verification" <no-reply@ora.ai>

