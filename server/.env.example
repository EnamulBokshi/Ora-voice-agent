# Server Config
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local Docker Dev URI:
MONGODB_URI=mongodb://ora_admin:ora_password_dev@localhost:27017/ora_db?authSource=admin

# Dedicated VPS Production Docker URI Example:
# MONGODB_URI=mongodb://ora_prod_admin:YOUR_PRODUCTION_PASSWORD@localhost:27018/ora_production?authSource=admin

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
# Production VPS Redis Port:
# REDIS_PORT=6380

# Security & Secrets
JWT_SECRET=super_secret_dev_key_change_in_production
ENCRYPTION_SECRET=ora-aes-256-secret-key-32bytes!
JWT_EXPIRATION=15m
# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (Resend)
RESEND_API_KEY=re_123456789_your_resend_api_key_here
RESEND_FROM_EMAIL=ORA Onboarding <onboarding@yourdomain.com>

# Alternative SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ORA Verification" <no-reply@ora.ai>
